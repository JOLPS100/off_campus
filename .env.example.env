# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000
APP_BASE_URL=http://localhost:4000

# Long random string - used to sign login tokens. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=umakwana

# From your PayChangu merchant dashboard (https://paychangu.com) after you register
# a business account. Do NOT use test/demo keys in production.
PAYCHANGU_SECRET_KEY=your_paychangu_secret_key
PAYCHANGU_PUBLIC_KEY=your_paychangu_public_key

# Must be a publicly reachable HTTPS URL once deployed - PayChangu calls this
# to tell your server a payment succeeded. localhost will NOT work for real
# payments; use a tunnel (ngrok) for local testing or your real domain in production.
PAYCHANGU_CALLBACK_URL=http://localhost:4000/api/payments/webhook

SUBSCRIPTION_PRICE_MWK=500
PHONE_SHARE_PRICE_MWK=500
